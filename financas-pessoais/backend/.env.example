PORT=4000
JWT_SECRET=troque-por-um-segredo-forte
DATA_DIR=./data

# Em produção, use um banco Turso (SQLite hospedado, com camada gratuita
# permanente) para os dados não se perderem em hospedagens com disco não
# persistente. Deixe em branco para desenvolvimento local (usa DATA_DIR acima).
# TURSO_DATABASE_URL=libsql://seu-banco-sua-org.turso.io
# TURSO_AUTH_TOKEN=

# Opcional em produção: origem(s) do frontend, separadas por vírgula
# CORS_ORIGIN=https://meu-app.vercel.app
