PORT=4000
JWT_SECRET=troque-por-um-segredo-forte
DATA_DIR=./data

# Em produção, use um banco Turso (SQLite hospedado, com camada gratuita
# permanente) para os dados não se perderem em hospedagens com disco não
# persistente. Deixe em branco para desenvolvimento local (usa DATA_DIR acima).
# TURSO_DATABASE_URL=libsql://seu-banco-sua-org.turso.io
# TURSO_AUTH_TOKEN=

# Opcional em produção: origem(s) do frontend, separadas por vírgula
# CORS_ORIGIN=https://meu-app.vercel.app

# E-mail (confirmação de cadastro e recuperação de senha) via Resend
# (https://resend.com — camada gratuita permanente, sem cartão). Sem
# RESEND_API_KEY, os e-mails só aparecem no log do servidor (útil em dev).
# RESEND_API_KEY=re_xxx
# MAIL_FROM=onboarding@resend.dev
# URL pública do frontend, usada para montar os links dos e-mails.
# FRONTEND_URL=https://meu-app.vercel.app
